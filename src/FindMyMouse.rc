#include <winres.h>
#include "resource.h"

IDI_APP ICON "FindMyMouse.ico"
1 RT_MANIFEST "FindMyMouse.manifest"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION 1,0,0,0
 PRODUCTVERSION 1,0,0,0
 FILEFLAGSMASK 0x3fL
 FILEOS 0x40004L
 FILETYPE 0x1L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "FileDescription", "Find My Mouse (standalone, based on PowerToys)"
            VALUE "FileVersion", "1.0.0.0"
            VALUE "InternalName", "FindMyMouse"
            VALUE "LegalCopyright", "MIT License - based on Microsoft PowerToys"
            VALUE "OriginalFilename", "FindMyMouse.exe"
            VALUE "ProductName", "Find My Mouse"
            VALUE "ProductVersion", "1.0.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
